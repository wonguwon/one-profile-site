<style>
  html { scroll-behavior: smooth; }
  ::-webkit-scrollbar { width: 5px; }
  ::-webkit-scrollbar-track { background: #f9fafb; }
  ::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 9999px; }
  ::-webkit-scrollbar-thumb:hover { background: #d1d5db; }
</style>

<script>
  const cover = document.getElementById('cover');
  const navBg = document.getElementById('nav-bg');
  const navGradient = document.getElementById('nav-gradient');
  const navLogo = document.getElementById('nav-logo');
  const navCta = document.getElementById('nav-cta');
  const navLinks = document.querySelectorAll('.nav-link');

  function onScroll() {
    const coverBottom = cover ? cover.getBoundingClientRect().bottom : 0;
    const scrolled = coverBottom <= 56; // nav height

    // Background panel
    navBg!.style.opacity = scrolled ? '1' : '0';
    // Top gradient (only over cover)
    navGradient!.style.opacity = scrolled ? '0' : '1';

    // Logo color
    (navLogo as HTMLElement).style.color = scrolled ? '#111827' : '#ffffff';

    // Nav links color
    navLinks.forEach(link => {
      (link as HTMLElement).style.color = scrolled ? '#6b7280' : 'rgba(255,255,255,0.9)';
    });

    // CTA button style
    const cta = navCta as HTMLElement;
    if (scrolled) {
      cta.style.background = '#111827';
      cta.style.color = '#ffffff';
      cta.style.border = '1px solid #111827';
    } else {
      cta.style.background = 'transparent';
      cta.style.color = '#ffffff';
      cta.style.border = '1px solid rgba(255,255,255,0.6)';
    }
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll(); // run on load
</script>
