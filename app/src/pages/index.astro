---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import profilePhoto from '../assets/jiwon.png';
import bgPhoto from '../assets/bg.jpg';
---

<Layout
  title="최지원 강사 | 지식 전달자 — IT·AI·AX 교육 전문가"
  description="복잡한 코딩과 낯선 AI를 일상의 다정한 대화로 풀어내는 IT 교육 전문가 최지원 강사. Java, Python, 생성형 AI, AX 교육, 기업 특강 전문."
>

  <!-- ===== NAVIGATION (fixed, scroll-aware) ===== -->
  <nav id="main-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <!-- Background panel (hidden over cover, shown when scrolled) -->
    <div id="nav-bg" class="absolute inset-0 bg-white/95 backdrop-blur-sm border-b border-gray-100 opacity-0 transition-opacity duration-300"></div>
    <!-- Top gradient for legibility over cover image -->
    <div id="nav-gradient" class="absolute inset-0 bg-gradient-to-b from-black/40 to-transparent pointer-events-none transition-opacity duration-300"></div>

    <div class="relative max-w-5xl mx-auto px-6 lg:px-8 h-14 flex items-center justify-between">
      <span id="nav-logo" class="text-sm font-semibold tracking-tight text-white transition-colors duration-300">최지원 강사</span>
      <div class="hidden md:flex items-center gap-7 text-sm">
        <a href="#about"          id="nav-link-1" class="nav-link text-white/90 hover:text-white transition-colors duration-300">소개</a>
        <a href="#teaching"       id="nav-link-2" class="nav-link text-white/90 hover:text-white transition-colors duration-300">강의 분야</a>
        <a href="#career"         id="nav-link-3" class="nav-link text-white/90 hover:text-white transition-colors duration-300">경력</a>
        <a href="#certifications" id="nav-link-4" class="nav-link text-white/90 hover:text-white transition-colors duration-300">자격</a>
      </div>
      <a
        href="mailto:one@oneground.ai.kr"
        id="nav-cta"
        class="text-sm px-4 py-1.5 rounded-full transition-all duration-300 font-medium border border-white/60 text-white hover:bg-white/20"
      >
        강의 문의
      </a>
    </div>
  </nav>

  <!-- ===== COVER IMAGE (full-width, top of page) ===== -->
  <div id="cover" class="relative w-full overflow-hidden" style="height: clamp(200px, 38vw, 360px);">
    <Image
      src={bgPhoto}
      alt="최지원 강사 강의 현장"
      class="w-full h-full object-cover object-center"
      width={1400}
      height={560}
      quality={80}
    />
    <!-- subtle dark vignette at top for nav legibility -->
    <div class="absolute inset-x-0 top-0 h-20 bg-gradient-to-b from-black/30 to-transparent pointer-events-none"></div>
    <!-- soft fade to white at bottom -->
    <div class="absolute inset-x-0 bottom-0 h-16 bg-gradient-to-t from-white to-transparent pointer-events-none"></div>
  </div>

  <!-- ===== HERO CONTENT ===== -->
  <section id="hero" class="relative z-10 max-w-5xl mx-auto px-6 lg:px-8 pb-16 lg:pb-24">
    <div class="flex flex-col lg:flex-row items-start gap-10 lg:gap-20">

      <!-- Profile Image — overlaps cover bottom -->
      <div class="relative z-10 flex-shrink-0 mx-auto lg:mx-0 -mt-14 sm:-mt-16">
        <div class="w-28 h-28 sm:w-36 sm:h-36 rounded-2xl overflow-hidden ring-3 ring-white shadow-lg bg-white">
          <Image
            src={profilePhoto}
            alt="최지원 강사 프로필 사진"
            class="w-full h-full object-cover object-center"
            width={144}
            height={144}
            quality={90}
          />
        </div>
      </div>

      <!-- Text Content -->
      <div class="flex-1 pt-4 lg:pt-6">
        <div class="mb-5">
          <div class="flex items-center gap-2.5 mb-3">
            <p class="text-2xl sm:text-3xl font-bold text-gray-900 tracking-tight">최지원</p>
            <span class="text-gray-300 font-light text-xl">|</span>
            <p class="text-sm font-semibold text-teal-600 tracking-wide">지식 전달자</p>
          </div>
          <h1 class="text-xl sm:text-2xl lg:text-[1.7rem] font-medium text-gray-500 leading-snug tracking-tight mb-4">
            복잡한 코딩과 낯선 AI를<br />
            일상의 다정한 대화로 풀어내는 사람.
          </h1>
          <p class="text-gray-500 text-base leading-relaxed max-w-xl">
            스타트업 0→1 빌딩 경험을 갖춘 개발자이자, K-DT 개발자양성 교육부터 기업 AX교육까지
            검증된 교육 전문가. 기술이 두렵지 않도록, 가장 편안한 방법으로 전달합니다.
          </p>
        </div>

        <!-- Meta info row -->
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-gray-400 mb-7 border-t border-gray-100 pt-5">
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 inline-block"></span>
            HRD기준 평균 교강사 평점 4.8+
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 inline-block"></span>
            양성 개발자 100명+
          </span>
          <span class="flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-teal-500 inline-block"></span>
            누적 수강생 1000명+
          </span>
        </div>

        <!-- CTA buttons -->
        <div class="flex flex-wrap items-center gap-3">
          <a
            href="mailto:one@oneground.ai.kr"
            class="inline-flex items-center gap-2 px-5 py-2.5 bg-gray-900 hover:bg-gray-700 text-white text-sm font-semibold rounded-lg transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            강의 문의하기
          </a>
          <a
            href="tel:010-2447-6990"
            class="inline-flex items-center gap-2 px-5 py-2.5 border border-gray-200 hover:border-gray-300 hover:bg-gray-50 text-gray-700 text-sm font-medium rounded-lg transition-colors"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            010-2447-6990
          </a>
          <div class="flex items-center gap-2 ml-1">
            <a
              href="https://github.com/wonguwon"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="GitHub"
              class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray-200 hover:border-gray-300 hover:bg-gray-50 text-gray-400 hover:text-gray-700 transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>
              </svg>
            </a>
            <a
              href="https://www.youtube.com/@mentor_oneground"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              class="w-9 h-9 flex items-center justify-center rounded-lg border border-gray-200 hover:border-gray-300 hover:bg-gray-50 text-gray-400 hover:text-red-500 transition-all"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ===== DIVIDER ===== -->
  <div class="max-w-5xl mx-auto px-6 lg:px-8">
    <hr class="border-gray-100" />
  </div>

  <!-- ===== ABOUT ===== -->
  <section id="about" class="max-w-5xl mx-auto px-6 lg:px-8 py-16 lg:py-20">

    <div class="mb-10">
      <p class="text-xs font-semibold text-teal-600 tracking-widest uppercase mb-2">About</p>
      <h2 class="text-2xl font-bold text-gray-900 tracking-tight">
        지식 전달자 최지원의 교육 철학은 무엇인가요?
      </h2>
    </div>

    <div class="grid lg:grid-cols-5 gap-10 lg:gap-16">

      <!-- Story -->
      <div class="lg:col-span-3 space-y-4 text-gray-600 leading-relaxed text-[0.95rem]">
        <p>
          저의 시작은 스타트업의 <strong class="text-gray-900 font-semibold">'첫 번째 개발자'</strong>였습니다.
          아무것도 없던 곳에서 서비스를 만들며 제가 가장 많이 했던 일은 코드를 치는 것만큼이나,
          제가 문제를 해결하는 방식을 동료들에게 설명하는 것이었습니다.
        </p>
        <p>
          복잡한 기술의 논리를 누구나 이해할 수 있게 설명했을 때 동료들의 반응과 함께 성장하는 기쁨.
          그 보람이 저를 개발자에서 '지식 전달자'의 길로 이끌었습니다.
        </p>
        <p>
          2023년부터 2026년까지 KDT를 포함한 다양한 국기훈련과정에서 100명이 넘는 개발자를 배출했으며,
          <strong class="text-gray-900 font-semibold">평균 교강사 평점 4.8점 이상</strong>이라는 과분한 사랑을 받았습니다.
        </p>
        <p>
          막막하고 멀기만 한 IT 기술을 보다 쉽고 재미있게 설명하는,
          여러분의 가장 다정한 파트너가 되어 함께 걷겠습니다.
        </p>
      </div>

      <!-- Philosophy -->
      <div class="lg:col-span-2 space-y-3">
        {[
          {
            num: "01",
            title: "어려운 것을 쉽게",
            desc: "초보자의 눈높이에서 낯선 용어의 장벽을 허뭅니다.",
            color: "border-l-teal-500"
          },
          {
            num: "02",
            title: "쉬운 것을 재미있게",
            desc: "기술이 내 삶을 어떻게 바꾸는지 생생한 예시로 들려줍니다.",
            color: "border-l-blue-500"
          },
          {
            num: "03",
            title: "재미있는 것을 깊이있게",
            desc: "재미를 넘어 실무에서 바로 써먹을 수 있는 단단한 실력을 만듭니다.",
            color: "border-l-violet-500"
          }
        ].map((p) => (
          <div class={`pl-4 border-l-2 ${p.color} py-1`}>
            <p class="text-[0.7rem] font-bold text-gray-300 tracking-widest mb-0.5">{p.num}</p>
            <p class="text-sm font-semibold text-gray-900 mb-1">{p.title}</p>
            <p class="text-xs text-gray-500 leading-relaxed">{p.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <div class="max-w-5xl mx-auto px-6 lg:px-8"><hr class="border-gray-100" /></div>

  <!-- ===== TEACHING AREAS ===== -->
  <section id="teaching" class="max-w-5xl mx-auto px-6 lg:px-8 py-16 lg:py-20">

    <div class="mb-10">
      <p class="text-xs font-semibold text-teal-600 tracking-widest uppercase mb-2">Teaching Areas</p>
      <h2 class="text-2xl font-bold text-gray-900 tracking-tight">
        최지원 강사의 주요 강의 분야는 어떻게 되나요?
      </h2>
      <p class="mt-3 text-sm text-gray-500 leading-relaxed">
        스타트업의 첫 개발자로 서비스의 A부터 Z까지 직접 구축해 본 경험을 바탕으로, 특정 기술에 매몰되지 않고 '문제 해결'에 초점을 맞춰 강의를 진행합니다.
      </p>
    </div>

    <!-- Table-style grid (제안서 느낌) -->
    <div class="border border-gray-200 rounded-xl overflow-hidden">
      {[
        {
          label: "개발",
          sub: "Development",
          color: "bg-teal-50",
          accent: "text-teal-700",
          dot: "bg-teal-500",
          items: [
            "웹 & 백엔드 개발 (Java 및 Python 프레임워크 활용)",
            "데이터베이스 설계 및 SQL 활용 능력 강화",
            "agentic ai 활용 개발 및 노코드, 로우코드 활용한 개발방법",
            "클라우드 기반 서비스 개발 및 운영"
          ]
        },
        {
          label: "인공지능",
          sub: "AI",
          color: "bg-blue-50",
          accent: "text-blue-700",
          dot: "bg-blue-500",
          items: [
            "AI & 머신러닝 (기본 원리부터 실전 서비스 응용까지)",
            "생성형 AI & LLM (프롬프트 엔지니어링, API 활용 기술)",
            "AI 에이전트 설계 및 구현"
          ]
        },
        {
          label: "업무 혁신",
          sub: "AX (AI Transformation)",
          color: "bg-violet-50",
          accent: "text-violet-700",
          dot: "bg-violet-500",
          items: [
            "워크플로우 자동화 (파이썬 업무 자동화, AI 도구 활용)",
            "기업 AX 역량 강화 교육 (디지털 전환 및 AI 실무 도입 전략)",
            "비개발자를 위한 AI 툴 활용 교육"
          ]
        }
      ].map((area, i) => (
        <div class={`flex flex-col sm:flex-row ${i > 0 ? 'border-t border-gray-200' : ''}`}>
          <div class={`${area.color} sm:w-44 lg:w-52 flex-shrink-0 px-6 py-5 flex flex-col justify-center`}>
            <p class={`text-sm font-bold ${area.accent}`}>{area.label}</p>
            <p class="text-xs text-gray-400 mt-0.5">{area.sub}</p>
          </div>
          <div class="flex-1 px-6 py-5 border-t sm:border-t-0 sm:border-l border-gray-200">
            <ul class="space-y-2">
              {area.items.map((item) => (
                <li class="flex items-start gap-2.5 text-sm text-gray-600">
                  <span class={`w-1.5 h-1.5 rounded-full ${area.dot} mt-1.5 flex-shrink-0`}></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- Feature tags -->
    <div class="flex flex-wrap gap-2 mt-5">
      {["기술 융합 강의", "최신 트렌드 특강", "기업 맞춤형 커리큘럼", "비전공자 친화적"].map((tag) => (
        <span class="text-xs px-3 py-1.5 bg-gray-100 text-gray-600 rounded-full font-medium">{tag}</span>
      ))}
    </div>

  </section>

  <div class="max-w-5xl mx-auto px-6 lg:px-8"><hr class="border-gray-100" /></div>

  <!-- ===== CAREER ===== -->
  <section id="career" class="max-w-5xl mx-auto px-6 lg:px-8 py-16 lg:py-20">

    <div class="mb-10">
      <p class="text-xs font-semibold text-teal-600 tracking-widest uppercase mb-2">Career</p>
      <h2 class="text-2xl font-bold text-gray-900 tracking-tight">
        최지원 강사의 실무 개발 및 교육 경력
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">

      <!-- Dev Career -->
      <div>
        <div class="flex items-center gap-2 mb-5">
          <span class="text-xs font-bold text-teal-600 tracking-widest uppercase">개발</span>
          <span class="flex-1 h-px bg-gray-100"></span>
        </div>
        <ul class="space-y-2">
          {[
            { text: "스타트업 초기 멤버 합류 및 50인 규모 조직 성장 주도 (0 to 1 빌딩)", tag: "0→1" },
            { text: "서비스 기획부터 설계, 배포, 운영까지 라이프사이클 전 과정 경험",    tag: "Full-Stack" },
            { text: "React, Spring 기반 피트니스 CRM 서비스 개발 및 운영",               tag: "CRM" },
            { text: "AI 에이전트 기반 무인 공간 관리 솔루션 구축",                        tag: "AI/LLM" },
            { text: "광명청년창업센터, 대한피트니스경영자협회 등 공공·민간 웹 외주 개발 다수", tag: "외주" },
            { text: "개발팀장(Team Lead) 및 프로젝트 매니저(PM) 업무 수행",              tag: "PM / Lead" }
          ].map((item) => (
            <li class="flex items-start gap-3 py-2.5 border-b border-gray-50 last:border-0">
              <span class="mt-[0.35rem] w-1.5 h-1.5 rounded-full bg-teal-400 flex-shrink-0"></span>
              <p class="flex-1 text-sm text-gray-700 leading-relaxed">{item.text}</p>
              <span class="mt-0.5 flex-shrink-0 text-[0.65rem] px-2 py-0.5 bg-teal-50 text-teal-700 rounded-full font-semibold">{item.tag}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Education Career -->
      <div>
        <div class="flex items-center gap-2 mb-5">
          <span class="text-xs font-bold text-blue-600 tracking-widest uppercase">교육</span>
          <span class="flex-1 h-px bg-gray-100"></span>
        </div>
        <ul class="space-y-2">
          {[
            { text: "KDT 및 국가기간전략산업훈련 교강사 7개 과정, 교강사 평점 평균 4.8점 이상 (2023~2026)", tag: "KDT" },
            { text: "IT 전공 및 비전공 수료생 120명 이상 배출 및 커리어 멘토링",                            tag: "멘토링" },
            { text: "현대중공업, 포스코DX, 한솔그룹 등 주요 기업 대상 AI 활용 및 AX(AI 전환) 교육 진행",  tag: "기업특강" },
